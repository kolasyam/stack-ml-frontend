# ---------- API ----------
NEXT_PUBLIC_API_BASE_URL=https://stack-ml-backend.onrender.com/api/v1
# Optional; only use for a private single-user deployment.
NEXT_PUBLIC_API_KEY=

# ---------- App Config ----------
NEXT_PUBLIC_APP_NAME=ML Knowledge Hub
NEXT_PUBLIC_MAX_UPLOAD_SIZE_MB=100
NEXT_PUBLIC_MAX_READER_SIZE_MB=50

# ---------- PDF.js worker (self-hosted in /public) ----------
NEXT_PUBLIC_PDF_WORKER_SRC=/pdf.worker.min.mjs
